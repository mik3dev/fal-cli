stment in semitones. Range: -100 to 100. Positive values raise pitch, negative values lower it.","type":"integer","title":"Pitch","minimum":-100,"maximum":100},"timbre":{"default":0,"description":"Timbre adjustment. Range: -100 to 100. Affects the tonal quality of the voice.","type":"integer","title":"Timbre","minimum":-100,"maximum":100},"intensity":{"default":0,"description":"Intensity/energy of the voice. Range: -100 to 100. Higher values create more energetic speech.","type":"integer","title":"Intensity","minimum":-100,"maximum":100}}},"LoudnessNormalizationSetting":{"x-fal-order-properties":["enabled","target_loudness","target_range","target_peak"],"type":"object","title":"LoudnessNormalizationSetting","properties":{"target_range":{"default":8,"description":"Target loudness range in LU (default 8.0)","type":"number","title":"Target Range","minimum":0,"maximum":20},"target_peak":{"default":-0.5,"description":"Target peak level in dBTP (default -0.5).","type":"number","title":"Target Peak","minimum":-3,"maximum":0},"enabled":{"default":true,"description":"Enable loudness normalization for the audio","type":"boolean","title":"Enabled"},"target_loudness":{"default":-18,"description":"Target loudness in LUFS (default -18.0)","type":"number","title":"Target Loudness","minimum":-70,"maximum":-10}}},"AudioSetting":{"x-fal-order-properties":["sample_rate","bitrate","format","channel"],"type":"object","title":"AudioSetting","properties":{"bitrate":{"default":128000,"description":"Bitrate of generated audio","enum":[32000,64000,128000,256000],"title":"Bitrate","type":"integer"},"format":{"default":"mp3","description":"Audio format","enum":["mp3","pcm","flac"],"title":"Format","type":"string"},"channel":{"default":1,"description":"Number of audio channels (1=mono, 2=stereo)","enum":[1,2],"title":"Channel","type":"integer"},"sample_rate":{"default":32000,"description":"Sample rate of generated audio","enum":[8000,16000,22050,24000,32000,44100],"title":"Sample Rate","type":"